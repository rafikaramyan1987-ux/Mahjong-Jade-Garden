{
  "name": "mahjong-jade-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mahjong Jade Garden - a calm, classic Mahjong Solitaire for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:web": "npm run build",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "build:playgama": "tsc --noEmit && vite build --mode playgama",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "playwright test --trace off",
    "test:e2e:gd": "playwright test -c playwright.gd.config.ts --trace off",
    "test:e2e:cg": "playwright test -c playwright.cg.config.ts --trace off",
    "audit": "tsx scripts/audit.ts --strict --md docs/audit.md",
    "audit:gamepix": "tsx --import ./scripts/gamepix-global.mjs scripts/audit.ts --strict",
    "submission:gd": "node scripts/submission-gd.mjs",
    "submission:crazygames": "node scripts/submission-cg.mjs",
    "submission:gamepix": "node scripts/submission-gamepix.mjs",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "submission:playgama": "npm run build:playgama && node scripts/playgama/zip.mjs",
    "check:playgama": "node scripts/playgama/check.mjs",
    "test:playgama": "node scripts/playgama/test.mjs",
    "qa:playgama": "node scripts/playgama/qa.mjs",
    "audio:levels": "node scripts/audio-levels.mjs --md docs/audio-levels.md --strict",
    "art": "node scripts/art.mjs",
    "record": "node scripts/record.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1"
  }
}
